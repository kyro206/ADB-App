{
  "name": "adb-app",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/update-db.mjs && paraglide-js compile --project ./project.inlang && vite",
    "dev:mock": "bun run scripts/update-db.mjs && paraglide-js compile --project ./project.inlang && vite --mode mock",
    "tauri:mock": "bun scripts/tauri-mock.mjs",
    "build": "bun run scripts/update-db.mjs && paraglide-js compile --project ./project.inlang && tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "tauri:windows:build": "bun run scripts/store-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.2.3",
    "@fontsource/material-symbols-rounded": "^5.2.45",
    "@material/web": "^2.4.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.26",
    "@inlang/paraglide-js": "^2.20.1",
    "@inlang/plugin-message-format": "^4.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^25.9.4",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.0"
  }
}
