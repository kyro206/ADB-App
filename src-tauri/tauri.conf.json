{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADB App",
  "version": "2.4.0",
  "identifier": "com.kyro.adbapp",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://kyro206.github.io/ADB-App/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxRTlDRDQ5REQ1NTNBQjIKUldTeU9sWGRTYzNwMFIyUURjdFcxbVVpT1FGajl2Y3FmSTRCdmsxN0hqVzhtQXMwNTZpSWZjVW0K"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../tools/java/info_apps.jar": "tools/java/info_apps.jar",
      "../tools/java/wallpaper_extractor.jar": "tools/java/wallpaper_extractor.jar"
    },
    "targets": ["nsis", "dmg", "app", "deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "publisher": "kyro206",
    "shortDescription": "Visual manager for the Android Debug Bridge (ADB).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/assets.car",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["scrcpy", "android-tools-adb"]
      }
    }
  }
}